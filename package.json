{
  "name": "newton",
  "version": "0.1.0",
  "private": true,
  "description": "Newton, an AI study companion by Twofold.",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/prepare-workspace-assets.mjs",
    "prebuild": "node scripts/prepare-workspace-assets.mjs",
    "test:e2e": "playwright test",
    "test:hosted": "node --env-file=.env.local --env-file=.env.hosted-test.local ./node_modules/vitest/vitest.mjs run --config vitest.hosted.config.mts",
    "voice:dev": "node scripts/dev-voice.mjs"
  },
  "dependencies": {
    "@deepgram/agents": "^0.2.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "mathlive": "^0.111.4",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "lodash-es": "^4.18.1"
  }
}
