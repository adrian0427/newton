# Optional for the scaffold. Copy to .env.local when implementing integrations.
# SERVER ONLY: permanent provider keys must never use NEXT_PUBLIC_ or reach the browser.
# Deepgram managed voice: /v1/auth/grant requires a Member-level key or higher.
# The browser receives only a short-lived temporary token issued by the server.
DEEPGRAM_API_KEY=
# npm run voice:dev enables guarded loopback testing; ordinary dev, production,
# and preview servers cannot issue tokens before authenticated integration.

# NOT required for initial Deepgram-managed voice.
# Optional, separately funded future whiteboard vision if OpenAI is selected;
# the analysis provider is still undecided. ChatGPT/Codex credits are not API credits.
OPENAI_API_KEY=

# Public project settings; intended for browser use. They do not replace auth/RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only trusted app origin for Google OAuth. Set the exact deployed HTTPS origin in production.
NEWTON_SITE_URL=http://localhost:3000
# Google client ID/secret belong in Supabase Auth provider settings, not this file.

# SERVER ONLY: handwriting transcription for explicit Read handwriting requests (free tiers only).
# Groq-hosted Qwen vision is preferred when GROQ_API_KEY is set; otherwise Gemma 4 via the Gemini API.
# Requests require a signed-in Supabase user. Only the whiteboard drawing PNG is sent; nothing is stored.
# Gemini API free-tier inputs may be reviewed by Google to improve its products; prefer Groq for student work.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: groq or gemini to force one provider; optional model overrides.
NEWTON_VISION_PROVIDER=
GROQ_VISION_MODEL=
GEMINI_VISION_MODEL=
