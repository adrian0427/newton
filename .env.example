# Optional for the scaffold. Copy to .env.local when implementing integrations.
# SERVER ONLY: never prefix this with NEXT_PUBLIC_ or send it to the browser.
DEEPGRAM_API_KEY=
# Deepgram Member-level key with Voice Agent access/credits; never expose to the browser.
# npm run voice:dev enables local-only short-lived grants. Production/previews remain closed.
# No OPENAI_API_KEY is needed for Deepgram-managed gpt-4o-mini.

# Public project settings; intended for browser use. They do not replace auth/RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
